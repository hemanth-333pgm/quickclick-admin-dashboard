import React, { useEffect, useState } from "react";
import { useParams, useNavigate } from "react-router-dom";
import api from "../lib/api";
import { DocumentCard, Doc } from "../components/DocumentCard";
import { RejectModal } from "../components/RejectModal";

export const DeliveryPartnerDetail: React.FC = () => {
  const { id } = useParams<{ id: string }>();
  const nav = useNavigate();
  const [partner, setPartner] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [rejectOpen, setRejectOpen] = useState(false);
  const [docReject, setDocReject] = useState<string | null>(null);

  const load = async () => {
    setLoading(true);
    try {
      const r = await api.get(`/admin/delivery-partners/${id}`);
      setPartner(r.data.data);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, [id]);

  const approvePartner = async () => {
    setBusy(true);
    try {
      await api.patch(`/admin/delivery-partners/${id}/verification`, {
        verificationStatus: "APPROVED",
      });
      nav("/delivery-partners");
    } finally { setBusy(false); }
  };

  const rejectPartner = async (reason: string) => {
    setBusy(true);
    try {
      await api.patch(`/admin/delivery-partners/${id}/verification`, {
        verificationStatus: "REJECTED",
        remarks: reason,
      });
      setRejectOpen(false);
      nav("/delivery-partners");
    } finally { setBusy(false); }
  };

  const approveDoc = async (type: string) => {
    if (!confirm(`Approve ${type}?`)) return;
    setBusy(true);
    try {
      await api.patch(`/admin/delivery-partners/${id}/documents/${type}`, {
        status: "APPROVED",
      });
      await load();
    } catch (e: any) {
      alert(e?.response?.data?.error?.message || "Failed");
    } finally { setBusy(false); }
  };

  const openDocReject = (type: string) => setDocReject(type);

  const rejectDoc = async (reason: string) => {
    if (!docReject) return;
    setBusy(true);
    try {
      await api.patch(`/admin/delivery-partners/${id}/documents/${docReject}`, {
        status: "REJECTED",
        remarks: reason,
      });
      setDocReject(null);
      await load();
    } catch (e: any) {
      alert(e?.response?.data?.error?.message || "Failed");
    } finally { setBusy(false); }
  };

  if (loading) return <div style={{ padding: 24 }}>Loading...</div>;
  if (!partner) return <div style={{ padding: 24 }}>Not found</div>;

  const vs = partner.verificationStatus || "PENDING";
  const statusColor =
    vs === "APPROVED" ? "#16a34a"
    : vs === "REJECTED" ? "#dc2626"
    : vs === "SUSPENDED" ? "#6b7280"
    : "#f59e0b";

  return (
    <div style={{ padding: 24, fontFamily: "system-ui, sans-serif" }}>
      <button
        onClick={() => nav("/delivery-partners")}
        style={{ background: 0, border: 0, color: "#2563eb", cursor: "pointer", marginBottom: 12 }}
      >
        ← Back to Delivery Partners
      </button>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <h1 style={{ margin: 0, fontSize: 24 }}>{partner.userId?.name || "Partner"}</h1>
        <span
          style={{
            background: statusColor + "20",
            color: statusColor,
            padding: "4px 12px",
            borderRadius: 12,
            fontSize: 12,
            fontWeight: 600,
          }}
        >
          {vs}
        </span>
      </div>

      <div
        style={{
          background: "#fff",
          borderRadius: 8,
          padding: 20,
          marginTop: 16,
          display: "grid",
          gridTemplateColumns: "repeat(2, 1fr)",
          gap: 16,
          fontSize: 14,
        }}
      >
        <div><strong>Mobile:</strong> {partner.userId?.mobile || partner.phone || "-"}</div>
        <div><strong>Email:</strong> {partner.userId?.email || partner.email || "-"}</div>
        <div><strong>Vehicle:</strong> {partner.vehicleType} · {partner.vehicleNumber}</div>
        <div><strong>Model:</strong> {partner.vehicleModel || "-"}</div>
        <div><strong>License No:</strong> {partner.licenseNumber || "-"}</div>
        <div><strong>Availability:</strong> {partner.availability || "-"}</div>
      </div>

      {partner.remarks && (
        <div style={{ marginTop: 16, padding: 12, background: "#fef2f2", color: "#991b1b", borderRadius: 6 }}>
          <strong>Remarks:</strong> {partner.remarks}
        </div>
      )}

      <h2 style={{ marginTop: 32, fontSize: 18 }}>Documents ({partner.documents?.length || 0})</h2>
      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))",
          gap: 16,
          marginTop: 12,
        }}
      >
        {partner.documents?.map((doc: Doc) => (
          <DocumentCard
            key={doc.type}
            doc={doc}
            onApprove={approveDoc}
            onReject={openDocReject}
          />
        ))}
        {(!partner.documents || partner.documents.length === 0) && (
          <div style={{ color: "#6b7280" }}>No documents uploaded</div>
        )}
      </div>

      <div style={{ marginTop: 32, display: "flex", gap: 12 }}>
        <button
          disabled={busy || vs === "APPROVED"}
          onClick={approvePartner}
          style={{
            padding: "10px 20px",
            background: "#16a34a",
            color: "#fff",
            border: 0,
            borderRadius: 6,
            fontSize: 14,
            fontWeight: 600,
            cursor: "pointer",
          }}
        >
          Approve Partner
        </button>
        <button
          disabled={busy || vs === "REJECTED"}
          onClick={() => setRejectOpen(true)}
          style={{
            padding: "10px 20px",
            background: "#dc2626",
            color: "#fff",
            border: 0,
            borderRadius: 6,
            fontSize: 14,
            fontWeight: 600,
            cursor: "pointer",
          }}
        >
          Reject Partner
        </button>
      </div>

      <RejectModal
        title="Reject Delivery Partner"
        open={rejectOpen}
        onClose={() => setRejectOpen(false)}
        onConfirm={rejectPartner}
      />
      <RejectModal
        title={`Reject Document: ${docReject}`}
        open={!!docReject}
        onClose={() => setDocReject(null)}
        onConfirm={rejectDoc}
      />
    </div>
  );
};

export default DeliveryPartnerDetail;
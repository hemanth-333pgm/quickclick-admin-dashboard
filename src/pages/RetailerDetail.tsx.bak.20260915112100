import React, { useEffect, useState } from "react";
import { useParams, useNavigate } from "react-router-dom";
import api from "../lib/api";
import { DocumentCard } from "../components/DocumentCard";
import type { Doc } from "../components/DocumentCard";
import { RejectModal } from "../components/RejectModal";

export const RetailerDetail: React.FC = () => {
  const params = useParams<{ id: string }>();
  const id = params.id || "";
  const nav = useNavigate();
  const [retailer, setRetailer] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [rejectOpen, setRejectOpen] = useState(false);
  const [docReject, setDocReject] = useState<string | null>(null);

  const load = async () => {
    setLoading(true);
    try {
      const r = await api.get("/admin/retailers/" + id);
      setRetailer(r.data.data);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, [id]);

  const approveStore = async () => {
    setBusy(true);
    try {
      await api.patch("/admin/retailers/" + id + "/status", { status: "APPROVED" });
      nav("/retailers");
    } finally { setBusy(false); }
  };

  const rejectStore = async (reason: string) => {
    setBusy(true);
    try {
      await api.patch("/admin/retailers/" + id + "/status", {
        status: "REJECTED",
        remarks: reason,
      });
      setRejectOpen(false);
      nav("/retailers");
    } finally { setBusy(false); }
  };

  const approveDoc = async (type: string) => {
    if (!window.confirm("Approve " + type + "?")) return;
    setBusy(true);
    try {
      await api.patch("/admin/retailers/" + id + "/documents/" + type, { status: "APPROVED" });
      await load();
    } catch (e: any) {
      alert(e?.response?.data?.error?.message || "Failed");
    } finally { setBusy(false); }
  };

  const openDocReject = (type: string) => setDocReject(type);

  const rejectDoc = async (reason: string) => {
    if (!docReject) return;
    setBusy(true);
    try {
      await api.patch("/admin/retailers/" + id + "/documents/" + docReject, {
        status: "REJECTED",
        remarks: reason,
      });
      setDocReject(null);
      await load();
    } catch (e: any) {
      alert(e?.response?.data?.error?.message || "Failed");
    } finally { setBusy(false); }
  };

  if (loading) return <div style={{ padding: 24 }}>Loading...</div>;
  if (!retailer) return <div style={{ padding: 24 }}>Not found</div>;

  const statusColor =
    retailer.status === "APPROVED" ? "#16a34a" :
    retailer.status === "REJECTED" ? "#dc2626" :
    retailer.status === "SUSPENDED" ? "#6b7280" :
    "#f59e0b";

  return (
    <div style={{ padding: 24, fontFamily: "system-ui, sans-serif" }}>
      <button
        onClick={() => nav("/retailers")}
        style={{ background: 0, border: 0, color: "#2563eb", cursor: "pointer", marginBottom: 12 }}
      >
        Back to Retailers
      </button>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <h1 style={{ margin: 0, fontSize: 24 }}>{retailer.shopName}</h1>
        <span style={{
          background: statusColor + "20",
          color: statusColor,
          padding: "4px 12px",
          borderRadius: 12,
          fontSize: 12,
          fontWeight: 600,
        }}>
          {retailer.status}
        </span>
      </div>

      <div style={{
        background: "#fff",
        borderRadius: 8,
        padding: 20,
        marginTop: 16,
        display: "grid",
        gridTemplateColumns: "repeat(2, 1fr)",
        gap: 16,
        fontSize: 14,
      }}>
        <div><strong>Owner:</strong> {retailer.ownerId?.name || "-"}</div>
        <div><strong>Mobile:</strong> {retailer.phone || retailer.ownerId?.mobile || "-"}</div>
        <div><strong>Email:</strong> {retailer.email || "-"}</div>
        <div><strong>Categories:</strong> {(retailer.categories || []).join(", ") || "-"}</div>
        <div><strong>Address:</strong> {retailer.address?.line1}, {retailer.address?.city}, {retailer.address?.state}</div>
        <div><strong>Postal:</strong> {retailer.address?.postalCode || "-"}</div>
      </div>

      {retailer.remarks && (
        <div style={{ marginTop: 16, padding: 12, background: "#fef2f2", color: "#991b1b", borderRadius: 6 }}>
          <strong>Remarks:</strong> {retailer.remarks}
        </div>
      )}

      <h2 style={{ marginTop: 32, fontSize: 18 }}>
        Documents ({(retailer.documents || []).length})
      </h2>

      <div style={{
        display: "grid",
        gridTemplateColumns: "repeat(auto-fill, minmax(300px, 1fr))",
        gap: 16,
        marginTop: 12,
      }}>
        {(retailer.documents || []).map((doc: Doc) => (
          <DocumentCard
            key={doc.type}
            doc={doc}
            onApprove={approveDoc}
            onReject={openDocReject}
          />
        ))}
        {(!retailer.documents || retailer.documents.length === 0) && (
          <div style={{ color: "#6b7280" }}>No documents uploaded</div>
        )}
      </div>

      <div style={{ marginTop: 32, display: "flex", gap: 12 }}>
        <button
          disabled={busy || retailer.status === "APPROVED"}
          onClick={approveStore}
          style={{
            padding: "10px 20px",
            background: "#16a34a",
            color: "#fff",
            border: 0,
            borderRadius: 6,
            fontSize: 14,
            fontWeight: 600,
            cursor: "pointer",
          }}
        >
          Approve Store
        </button>
        <button
          disabled={busy || retailer.status === "REJECTED"}
          onClick={() => setRejectOpen(true)}
          style={{
            padding: "10px 20px",
            background: "#dc2626",
            color: "#fff",
            border: 0,
            borderRadius: 6,
            fontSize: 14,
            fontWeight: 600,
            cursor: "pointer",
          }}
        >
          Reject Store
        </button>
      </div>

      <RejectModal
        title="Reject Retailer"
        open={rejectOpen}
        onClose={() => setRejectOpen(false)}
        onConfirm={rejectStore}
      />
      <RejectModal
        title={"Reject Document: " + (docReject || "")}
        open={!!docReject}
        onClose={() => setDocReject(null)}
        onConfirm={rejectDoc}
      />
    </div>
  );
};

export default RetailerDetail;
